#!/usr/bin/env bash
#
# dsh -- DeepSeek Harness (DSH RAGE) CLI Launcher
# Executable launcher for DeepSeek Harness OTP Release.
#
# The launcher auto-assembles the OTP release the first time it runs, and
# automatically re-assembles it with `--overwrite` whenever any source file
# (lib/**, mix.exs, mix.lock, config/**, priv/**) is newer than the existing
# release binary. This keeps the release in sync with the working tree without
# requiring a manual `mix release --overwrite` step.
#
# Usage:
#   ./dsh                      Auto-detect release (prod -> dev -> mix run)
#   ./dsh --env prod           Explicitly launch production release
#   ./dsh --env dev            Explicitly launch development release
#   ./dsh --prod               Explicitly launch production release
#   ./dsh --dev                Explicitly launch development release
#
# Configuration:
#   DLLB_HOST       dllb server host                (default 127.0.0.1)
#   DLLB_PORT       dllb server port                (default 3009)
#   DLLB_DIR        dllb server repo                (default: <dsh>/../dllb)
#   DLLB_START      command used to start dllb       (default: ./start_prod.sh)
#   DLLB_LOG        dllb log file                   (default: <dllb>/dllb.log)
#   DLLB_WAIT       seconds to wait for dllb readiness (default 60)
#   DSH_REBUILD     force release rebuild            (default: auto)
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_ENV="${DSH_ENV:-auto}"

ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env)
      TARGET_ENV="$2"
      shift 2
      ;;
    --prod)
      TARGET_ENV="prod"
      shift
      ;;
    --dev)
      TARGET_ENV="dev"
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

# ---- dllb server lazy startup --------------------------------------------
DLLB_HOST="${DLLB_HOST:-127.0.0.1}"
DLLB_PORT="${DLLB_PORT:-3009}"
DLLB_DIR_DEFAULT="$(cd -- "${SCRIPT_DIR}/../dllb" >/dev/null 2>&1 && pwd || echo "${SCRIPT_DIR}/../dllb")"
DLLB_DIR="${DLLB_DIR:-${DLLB_DIR_DEFAULT}}"
DLLB_START="${DLLB_START:-./start_prod.sh}"
DLLB_LOG="${DLLB_LOG:-${DLLB_DIR}/dllb.log}"
DLLB_WAIT="${DLLB_WAIT:-60}"

port_up() {
  local host="$1" port="$2"
  (exec 3<>"/dev/tcp/${host}/${port}") 2>/dev/null
}

if port_up "${DLLB_HOST}" "${DLLB_PORT}"; then
  echo "[INFO] dllb server already listening on ${DLLB_HOST}:${DLLB_PORT}"
else
  if [[ ! -d "${DLLB_DIR}" ]]; then
    echo "[ERROR] dllb repo not found at ${DLLB_DIR} (set DLLB_DIR)" >&2
    exit 1
  fi
  echo "[INFO] Starting dllb server in ${DLLB_DIR}…"
  (
    cd -- "${DLLB_DIR}"
    nohup ${DLLB_START} >>"${DLLB_LOG}" 2>&1 &
    echo "$!" >"${DLLB_DIR}/.dllb.pid"
  )
  echo "[INFO] Waiting up to ${DLLB_WAIT}s for ${DLLB_HOST}:${DLLB_PORT}…"
  waited=0
  until port_up "${DLLB_HOST}" "${DLLB_PORT}"; do
    if [[ "${waited}" -ge "${DLLB_WAIT}" ]]; then
      echo "[ERROR] dllb did not become ready within ${DLLB_WAIT}s -- check ${DLLB_LOG}" >&2
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "[INFO] dllb server is ready (after ${waited}s)"
fi

PROD_REL="$SCRIPT_DIR/_build/prod/rel/dsh/bin/dsh"
DEV_REL="$SCRIPT_DIR/_build/dev/rel/dsh/bin/dsh"

# ---- release freshness detection -----------------------------------------
# Returns 0 (true) if the given release binary is missing or if any source
# file is newer than it, meaning the release must be re-assembled with the
# --overwrite flag. Returns 1 (false) when the existing release is up to date.
#
# The set of watched source globs mirrors what `mix release` consumes: the
# project manifest, lockfile, application config, lib sources and priv assets.
release_needs_build() {
  local rel_bin="$1"
  [[ ! -x "${rel_bin}" ]] && return 0

  # DSH_REBUILD=1 forces a rebuild regardless of file timestamps.
  if [[ "${DSH_REBUILD:-0}" == "1" ]]; then
    return 0
  fi

  local rel_mtime
  rel_mtime="$(stat -c %Y "${rel_bin}" 2>/dev/null || stat -f %m "${rel_bin}" 2>/dev/null || echo 0)"

  local glob
  for glob in "${SCRIPT_DIR}"/mix.exs "${SCRIPT_DIR}"/mix.lock \
              "${SCRIPT_DIR}"/lib/**/*.ex "${SCRIPT_DIR}"/lib/**/*.exs \
              "${SCRIPT_DIR}"/config/**/*.exs "${SCRIPT_DIR}"/priv/**/*; do
    # If no files match a glob, bash leaves the literal pattern; skip it.
    [[ -e "${glob}" ]] || continue

    local src_mtime
    src_mtime="$(stat -c %Y "${glob}" 2>/dev/null || stat -f %m "${glob}" 2>/dev/null || echo 0)"
    if (( src_mtime > rel_mtime )); then
      echo "[INFO] Rebuilding release: ${glob} is newer than the release binary."
      return 0
    fi
  done

  return 1
}

# Assembles the requested release with mix release, always passing --overwrite
# so an existing release directory is replaced rather than merged. Stale
# release artifacts under _build/<env>/rel are cleaned first to guarantee a
# deterministic build.
build_release() {
  local env="$1"
  echo "[INFO] Assembling ${env} OTP release…"
  (
    cd "${SCRIPT_DIR}"
    rm -rf "_build/${env}/rel/dsh"
    MIX_ENV="${env}" mix release dsh --overwrite
  )
}

case "$TARGET_ENV" in
  prod)
    export DSH_ENV="prod"
    if release_needs_build "$PROD_REL"; then
      build_release "prod"
    fi
    exec "$PROD_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
    ;;

  dev)
    export DSH_ENV="dev"
    if release_needs_build "$DEV_REL"; then
      build_release "dev"
    fi
    exec "$DEV_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
    ;;

  *)
    if [[ -x "$PROD_REL" ]] && ! release_needs_build "$PROD_REL"; then
      export DSH_ENV="prod"
      exec "$PROD_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
    elif [[ -x "$DEV_REL" ]] && ! release_needs_build "$DEV_REL"; then
      export DSH_ENV="dev"
      exec "$DEV_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
    elif [[ -x "$PROD_REL" ]] || [[ -x "$DEV_REL" ]]; then
      # A release exists but is stale; rebuild the most recently used one.
      if [[ -x "$PROD_REL" ]] && [[ -x "$DEV_REL" ]]; then
        if [[ "$PROD_REL" -nt "$DEV_REL" ]]; then
          export DSH_ENV="prod"
          build_release "prod"
          exec "$PROD_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
        else
          export DSH_ENV="dev"
          build_release "dev"
          exec "$DEV_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
        fi
      elif [[ -x "$PROD_REL" ]]; then
        export DSH_ENV="prod"
        build_release "prod"
        exec "$PROD_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
      else
        export DSH_ENV="dev"
        build_release "dev"
        exec "$DEV_REL" eval "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
      fi
    else
      export DSH_ENV="dev"
      cd "$SCRIPT_DIR"
      exec mix run --no-halt -e "DeepSeekHarness.CLI.Main.main(System.argv())" -- "${ARGS[@]}"
    fi
    ;;
esac
